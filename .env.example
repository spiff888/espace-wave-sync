# Copy to .env and fill in. .env is gitignored.

# WAVE server on your LAN. Use the local address, not the cloud relay.
WAVE_URL=https://192.0.2.10:7001

# A dedicated LOCAL (not cloud) WAVE user with the minimum rights needed
# to edit the shared layout and create bookmarks. Never an admin account.
WAVE_USERNAME=campus-board
WAVE_PASSWORD=change-me

# Base URL of your espace-events-kiosk instance (serves /api/v1/events)
KIOSK_URL=http://localhost:3000

# WAVE servers use a self-signed certificate. Export it to this file:
#   openssl s_client -connect <server>:7001 -showcerts </dev/null 2>/dev/null \
#     | awk '/BEGIN CERT/,/END CERT/' > wave-ca.pem
# There is intentionally no "ignore TLS errors" option.
WAVE_CA_CERT=./wave-ca.pem

# WAVE's certificate is issued to the server ID, not its IP. Put that ID here
# (the DNS: value from: openssl x509 -in wave-ca.pem -noout -ext subjectAltName)
# so WAVE_URL can stay an IP address. Leave unset if WAVE_URL already matches.
WAVE_TLS_SERVERNAME=00000000-0000-0000-0000-000000000000

# Seconds between sync cycles
SYNC_INTERVAL_SECONDS=60

# true = log what would change, touch nothing. Flip to false when happy.
DRY_RUN=true

CONFIG_PATH=./config.json
STATE_PATH=./state.json

# Time zone the events are in
TZ=America/Los_Angeles
