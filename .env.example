# Copy to .env and fill in. .env is gitignored.

# WAVE server on your LAN. Use the local address, not the cloud relay.
WAVE_URL=https://wave.example.local:7001

# A dedicated LOCAL (not cloud) WAVE user with the minimum rights needed
# to edit the shared layout and create bookmarks. Never an admin account.
WAVE_USERNAME=campus-board
WAVE_PASSWORD=change-me

# Base URL of your espace-events-kiosk instance (serves /api/v1/events)
KIOSK_URL=http://localhost:3000

# WAVE servers usually have a self-signed certificate. Export it and point
# Node at it. There is intentionally no "ignore TLS errors" option.
NODE_EXTRA_CA_CERTS=./wave-ca.pem

# Seconds between sync cycles
SYNC_INTERVAL_SECONDS=60

# true = log what would change, touch nothing. Flip to false when happy.
DRY_RUN=true

CONFIG_PATH=./config.json
STATE_PATH=./state.json

# Time zone the events are in
TZ=America/Los_Angeles
